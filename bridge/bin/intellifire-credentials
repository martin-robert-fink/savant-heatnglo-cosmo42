#!/usr/bin/env ruby
# Fetches the per-fireplace API key and account user id from iftapi.net and
# writes them to a credentials.json the bridge can read.
#
# This is the one and only time the cloud is involved. Everything the bridge
# does afterwards is local to your LAN.
#
#   Usage: intellifire-credentials [--out PATH] [--email you@example.com]
$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'intellifire_bridge/version'
require 'io/console'
require 'json'
require 'net/http'
require 'optparse'
require 'uri'

API = 'https://iftapi.net/a'.freeze

options = { out: 'credentials.json' }
OptionParser.new do |parser|
  parser.banner = 'Usage: intellifire-credentials [options]'
  parser.on('--out PATH', 'Where to write credentials.json (default: ./credentials.json)') do |value|
    options[:out] = value
  end
  parser.on('--email EMAIL', 'IntelliFire account email') { |value| options[:email] = value }
  parser.on('--print', 'Print to stdout instead of writing a file') { options[:print] = true }
  parser.on('-h', '--help') do
    puts parser
    exit 0
  end
end.parse!

# --- tiny cookie-aware HTTP helper -------------------------------------------

class Session
  def initialize
    @cookies = {}
  end

  attr_reader :cookies

  def post_form(path, form)
    uri = URI("#{API}#{path}")
    request = Net::HTTP::Post.new(uri)
    request.set_form_data(form)
    perform(uri, request)
  end

  def get(path)
    uri = URI("#{API}#{path}")
    perform(uri, Net::HTTP::Get.new(uri))
  end

  def json(path)
    response = get(path)
    unless response.is_a?(Net::HTTPSuccess)
      abort "iftapi.net returned HTTP #{response.code} for #{path}"
    end

    JSON.parse(response.body)
  rescue JSON::ParserError => e
    abort "Could not parse response from #{path}: #{e.message}"
  end

  private

  def perform(uri, request)
    request['Cookie'] = @cookies.map { |k, v| "#{k}=#{v}" }.join('; ') unless @cookies.empty?
    response = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(request) }
    absorb_cookies(response)
    response
  end

  def absorb_cookies(response)
    Array(response.get_fields('Set-Cookie')).each do |header|
      name, value = header.split(';', 2).first.to_s.split('=', 2)
      @cookies[name.strip] = value.to_s.strip if name && value
    end
  end
end

# --- login -------------------------------------------------------------------

email = options[:email]
if email.nil? || email.empty?
  print 'IntelliFire account email: '
  email = $stdin.gets.to_s.strip
end

print 'IntelliFire account password: '
password = $stdin.noecho(&:gets).to_s.chomp
puts

abort 'Email and password are both required.' if email.empty? || password.empty?

session = Session.new
response = session.post_form('/login', 'username' => email, 'password' => password)

unless response.code == '204'
  abort "Login failed (HTTP #{response.code}). Check the email and password you use in the IntelliFire app."
end

user_id = session.cookies['user']
abort 'Login succeeded but no user cookie was returned.' if user_id.nil? || user_id.empty?

puts "Logged in. user id: #{user_id}"

# --- enumerate fireplaces ----------------------------------------------------

locations = session.json('/enumlocations')['locations'] || []
abort 'No locations found on this account.' if locations.empty?

found = []
locations.each do |location|
  location_id = location['location_id']
  fireplaces = session.json("/enumfireplaces?location_id=#{location_id}")['fireplaces'] || []

  fireplaces.each do |fireplace|
    serial = fireplace['serial']
    # The cloud poll is what knows the appliance's current LAN address.
    ip = begin
      session.json("/#{serial}//apppoll")['ipv4_address']
    rescue SystemExit, StandardError
      nil
    end

    found << {
      'location_name' => location['location_name'],
      'name' => fireplace['name'],
      'brand' => fireplace['brand'],
      'serial' => serial,
      'api_key' => fireplace['apikey'],
      'user_id' => user_id,
      'ip_address' => ip
    }
  end
end

abort 'No fireplaces found on this account.' if found.empty?

puts
found.each_with_index do |fireplace, index|
  puts "[#{index + 1}] #{fireplace['name']} (#{fireplace['brand']}) " \
       "at #{fireplace['location_name']} — #{fireplace['ip_address'] || 'IP unknown'}"
end

selected =
  if found.length == 1
    found.first
  else
    print "\nWhich fireplace? [1-#{found.length}]: "
    index = $stdin.gets.to_i
    abort 'Invalid selection.' unless (1..found.length).cover?(index)
    found[index - 1]
  end

credentials = selected.slice('ip_address', 'api_key', 'user_id', 'serial')

if selected['ip_address'].nil?
  warn "\nWarning: could not determine the fireplace's IP address. Set ip_address by hand."
end

if options[:print]
  puts JSON.pretty_generate(credentials)
else
  File.write(options[:out], "#{JSON.pretty_generate(credentials)}\n")
  File.chmod(0o600, options[:out])
  puts "\nWrote #{options[:out]} (mode 0600)."
  puts 'Give the fireplace a DHCP reservation so ip_address stays valid.'
end
